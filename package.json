{
  "name": "tasks-firefox",
  "version": "0.1.7",
  "private": true,
  "description": "Firefox-Erweiterung: Aufgabenlisten in der Seitenleiste, synchronisiert über Firefox Sync.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "testdata": "node scripts/testdata.mjs",
    "test": "node tests/run.cjs",
    "test:e2e": "node tests/e2e/add-to-tasks.cjs",
    "test:e2e:chat": "node tests/e2e/chat.cjs",
    "lint": "web-ext lint --self-hosted",
    "build": "web-ext build --overwrite-dest",
    "sign": "bash scripts/sign.sh"
  },
  "devDependencies": {
    "jsdom": "^24.1.3",
    "web-ext": "^10.5.0"
  }
}
